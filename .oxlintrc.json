{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "oxc",
    "promise",
    "react",
    "react-perf",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // React 17+ 自动 JSX runtime，不需要 React 在作用域内。
    // 注意：react/immutability 故意保持开启 —— 项目启用了 reactCompiler，
    // useNativeState 必须用 .get()/.set()，直接写 .value 会被 React Compiler 判定为违规。
    "react/react-in-jsx-scope": "off",
    // @expo/ui 已于 2026-10-16 从项目移除（迁移计划 §6.9）。这里从「平台护栏」
    // 改成「不要再引回来」—— 它的两个平台子包混用会抛 Unable to get view config
    // 或被静默忽略，见 docs/conventions/ui-design.md「平台专属组件隔离」。
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@expo/ui", "@expo/ui/*"],
            "message": "@expo/ui 已移除（迁移计划 §6.9）。内容树用纯 RN，玻璃用 GlassChip / GlassHostButton，日期用 RnDateTimePicker，菜单用 RnPicker；确实绕不过请先在迁移计划里记档。"
          },
          {
            "group": ["@react-navigation/*"],
            "message": "SDK 56+ 不要直接依赖 @react-navigation/*，请从 expo-router/react-navigation 导入。"
          }
        ],
        "paths": [
          {
            "name": "react-native",
            "importNames": [
              "Switch",
              "Picker",
              "SafeAreaView",
              "AsyncStorage",
              "WebView"
            ],
            "message": "react-native 的这些模块已移除：Picker / SafeAreaView / AsyncStorage / WebView 各有替代（RnPicker / react-native-safe-area-context / @react-native-async-storage/async-storage）。Switch 在纯 RN 屏可用，但需单行豁免并注明原因。"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Gesture.Pan() 是 react-native-gesture-handler 的 builder API，
      // 不是把组件当函数调用；React Compiler 的 capitalized-calls 看不穿这条链式调用，属误报
      "files": ["src/components/reminder-card-stack.tsx"],
      "rules": {
        "react/capitalized-calls": "off"
      }
    },
    {
      // 查询 Hook（useQuery）的首次载入：load() 是 async，setState 发生在 await 之后的微任务里，
      // 不是同步调用，不会级联渲染。react/set-state-in-effect 看不穿 async 边界，属误报；
      // oxlint 行内禁用对该规则无效，故在此按文件关闭。
      "files": ["src/lib/store.ts"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      // 订阅 Hook 的首次载入：load() 是 async，setState 发生在 await 之后的微任务里，
      // 不是同步调用，不会级联渲染。react/set-state-in-effect 看不穿 async 边界，属误报；
      // oxlint 行内禁用对该规则无效，故在此按文件关闭（与 src/lib/store.ts 同一理由）。
      "files": ["src/hooks/use-subscription.ts"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      // 语言切换后要重注册通知文案：effect 体内经 getTranslator() 间接读
      // language，lint 看不穿这层间接依赖，误判为多余依赖
      "files": ["src/app/_layout.tsx"],
      "rules": {
        "react/exhaustive-effect-dependencies": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    ".expo",
    "ios",
    "android",
    "assets",
    "design",
    "maestro",
    ".agents",
    ".claude",
    ".od-skills",
    ".opencode",
    "expo-env.d.ts"
  ]
}
