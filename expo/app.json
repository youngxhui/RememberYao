{
  "expo": {
    "name": "RememberYao",
    "slug": "remember-yao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rememberyao",
    "userInterfaceStyle": "automatic",
    "ios": {
      "deploymentTarget": "26.0",
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "top.youngxhui.rememberyao.k3f9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "top.youngxhui.rememberyao",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      "expo-widgets",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "top.youngxhui.rememberyao.k3f9.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.top.youngxhui.rememberyao.k3f9"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f0af2784-8ff7-40fa-a002-4fdb35957b38"
      }
    },
    "owner": "youngxhui"
  }
}
